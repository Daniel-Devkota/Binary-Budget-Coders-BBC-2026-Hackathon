# ─── Supabase (safe in the frontend; RLS is what protects data) ───────────────
# Dashboard → Project Settings → Data API → Project URL
# NOTE: base URL only, no trailing /rest/v1/
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard → Project Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Enables the force-complete-booking shortcut used in the demo. Never "true" in prod.
VITE_ENABLE_DEV_TOOLS=true

# ─── SERVER-SIDE ONLY — never prefix these with VITE_, never commit real values ─
# These belong in Supabase Edge Function secrets:
#   npx supabase secrets set GEMINI_API_KEY=...
#
# GEMINI_API_KEY=            # aistudio.google.com — skill-request dedupe (Phase 2)
# SUPABASE_SECRET_KEY=       # Dashboard → API Keys → Secret key. Bypasses ALL RLS.
